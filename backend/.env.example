# Project Name
PROJECT_NAME="Research Paper Assistant"
API_V1_STR="/api"

# Database Configuration
# In production, replace with your Neon database URL:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://rpa_user:rpa_password@localhost:5432/rpa_db

# Security Settings
JWT_SECRET="super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vector Embedding Configuration
EMBEDDING_PROVIDER="huggingface" # 'openai' or 'huggingface'
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
OPENAI_API_KEY=""

# LLM Configuration
LLM_PROVIDER="groq" # 'groq' or 'openai'
GROQ_API_KEY=""
GROQ_MODEL_NAME="llama-3.1-70b-versatile"
OPENAI_MODEL_NAME="gpt-4o-mini"

# Qdrant Vector Database
QDRANT_URL=""
QDRANT_API_KEY=""

# AWS S3 Storage Config
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""
